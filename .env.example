# ─── Supabase ─────────────────────────────────────────────────────────────────
# Create a project at https://supabase.com and paste your credentials here.
# Without these the app runs with demo/mock data — no real DB needed locally.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ─── Razorpay (test mode) ──────────────────────────────────────────────────────
# Get test keys from https://dashboard.razorpay.com → Settings → API Keys
# NEVER use live keys here. Test keys begin with rzp_test_
VITE_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID

# ─── WhatsApp ─────────────────────────────────────────────────────────────────
# Your business WhatsApp number in international format (no + or spaces)
VITE_WHATSAPP_NUMBER=919876543210

# ─── Store ────────────────────────────────────────────────────────────────────
VITE_STORE_NAME=Dainty.muse
VITE_STORE_EMAIL=hello@daintymuse.com
VITE_STORE_INSTAGRAM=daintymuse
